# ==============================================================================
# ARK (Air-gapped Retrieval & Knowledge) - Environment Configuration
# Copy this file to .env and customize all secrets before deploying.
# ==============================================================================

# Release version (CalVer; keep aligned with ./VERSION)
ARK_VERSION=2026.11.0

# ------------------------------------------------------------------------------
# Site & Network Settings
# ------------------------------------------------------------------------------
ARK_DOMAIN=ark.local
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# Container Images (Pinned for deterministic air-gapped bundling)
# ------------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai:v0.6.4.post1
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.6
QDRANT_IMAGE=qdrant/qdrant:v1.12.5
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.5.10
POSTGRES_IMAGE=postgres:16-alpine
TIKA_IMAGE=apache/tika:3.1.0.0-full
TIKA_IMAGE_DIGEST=sha256:1221afa48af9158e14b8d005bbcfa49f3d7fc4e5113db48cad586955bc64992b
CADDY_IMAGE=caddy:2-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.7.1
ARK_ADMIN_IMAGE=ark-admin:latest
ARK_LLM_ADMIN_IMAGE=ark-llm-admin:latest

# ------------------------------------------------------------------------------
# Hugging Face Models (Downloaded at HQ into ./artifacts/models/<dir>)
# ------------------------------------------------------------------------------
# Primary chat/instruct LLM served by vLLM
LLM_MODEL_ID=Qwen/Qwen2.5-14B-Instruct
LLM_MODEL_DIR=Qwen--Qwen2.5-14B-Instruct
LLM_SERVED_NAME=ark-llm

# Embedding model served by TEI (1024-dim for BAAI/bge-m3)
EMBED_MODEL_ID=BAAI/bge-m3
EMBED_MODEL_DIR=BAAI--bge-m3
EMBED_VECTOR_SIZE=1024

# Reranker model served by TEI
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DIR=BAAI--bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# LLM Backend (Separate ARK LLM Server, 3rd-Party OpenAI API, or Local vLLM)
# ------------------------------------------------------------------------------
# Backend provider type: "ark_llm" (shows reference link to ARK LLM Backend Console) or "third_party"
LLM_BACKEND_TYPE=ark_llm
# URL to the ARK LLM Backend Console (only used when LLM_BACKEND_TYPE=ark_llm)
LLM_BACKEND_ADMIN_URL=http://localhost:8095
# OpenAI-compatible base URL including /v1:
# - Single-server local vLLM (docker compose --profile local-llm up -d): http://vllm:8000/v1
# - Separate ARK LLM server (docker-compose.llm.yml): http://<llm-server-ip>:8000/v1
# - 3rd-party OpenAI-compatible API: http://litellm.internal:4000/v1 or https://api.openai.com/v1
LLM_API_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=sk-ark-local-replace-with-strong-key
# Optional health endpoint (blank = probe ${LLM_API_BASE_URL}/models with Bearer key)
LLM_HEALTH_URL=

# ------------------------------------------------------------------------------
# vLLM & GPU Tuning (for --profile local-llm or standalone docker-compose.llm.yml)
# ------------------------------------------------------------------------------
VLLM_API_KEY=sk-ark-local-replace-with-strong-key
VLLM_BIND_IP=0.0.0.0
VLLM_PORT=8000
# Bind LLM Admin Console to localhost by default; set to LAN/WireGuard IP only on dedicated LLM servers
LLM_ADMIN_BIND_IP=127.0.0.1
LLM_ADMIN_PORT=8095
LLM_ADMIN_TOKEN=
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_COUNT=all

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_API_KEY=qdrant-ark-replace-with-strong-key
QDRANT_URL=http://127.0.0.1:6333

# ------------------------------------------------------------------------------
# PostgreSQL 16 (Open WebUI Backing Store)
# ------------------------------------------------------------------------------
POSTGRES_USER=ark_webui
POSTGRES_PASSWORD=postgres-ark-replace-with-strong-password
POSTGRES_DB=openwebui

# ------------------------------------------------------------------------------
# Open WebUI Configuration
# ------------------------------------------------------------------------------
WEBUI_SECRET_KEY=webui-ark-replace-with-64-char-random-hex
WEBUI_URL=https://ark.local
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=false
DEFAULT_USER_ROLE=user

# Optional: Admin API token for provisioning/bootstrap_ark.py & ark-admin
OPENWEBUI_API_KEY=

# ------------------------------------------------------------------------------
# Keycloak Identity Broker (SSO: AD/LDAPS, Kerberos, SAML 2.0)
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak-ark-replace-with-strong-password
OIDC_OPENWEBUI_CLIENT_SECRET=ark-openwebui-oidc-secret-change-me
OIDC_OAUTH2_PROXY_CLIENT_SECRET=ark-oauth2-proxy-secret-change-me
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64-cookie-secret

# ------------------------------------------------------------------------------
# ARK Control Plane, Backups & SIEM Audit Forwarding
# ------------------------------------------------------------------------------
ARK_BACKUP_DIR=./data/backups
ARK_PROXY_AUTH_SECRET=replace-with-32-byte-random-hex-proxy-secret
# Dedicated Fernet key for encrypting connector/LLM secrets at rest in PostgreSQL.
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ARK_SECRETS_KEY=
ARK_SHARES_DIR=./data/shares
ARK_INGEST_MAX_CONCURRENT_JOBS=2
ARK_INGEST_JOB_TIMEOUT_SEC=1800
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTOCOL=udp

# ------------------------------------------------------------------------------
# On-Prem Active Directory (LDAPS) Authentication
# ------------------------------------------------------------------------------
ENABLE_LDAP=false
LDAP_SERVER_LABEL=Corporate Active Directory
LDAP_SERVER_HOST=dc01.corp.internal
LDAP_SERVER_PORT=636
LDAP_USE_TLS=true
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT_FILE=/certs/ad-ca.crt
LDAP_ATTRIBUTE_FOR_MAIL=mail
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_SEARCH_BASE=DC=corp,DC=internal
# Example: only allow enabled users in the ARK-Users security group
LDAP_SEARCH_FILTERS=(&(objectClass=user)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
LDAP_APP_DN=CN=svc-ark-ldap,OU=ServiceAccounts,DC=corp,DC=internal
LDAP_APP_PASSWORD=ad-service-account-password

# Optional: AD Group Sync prefix (maps AD group 'ARK-Project-Alpha' -> Open WebUI 'project-alpha')
AD_GROUP_PREFIX=ARK-

# ------------------------------------------------------------------------------
# Strict Air-Gap & Telemetry Enforcement
# ------------------------------------------------------------------------------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DO_NOT_TRACK=1
OFFLINE_MODE=true
QDRANT__TELEMETRY_DISABLED=true
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true
VLLM_NO_USAGE_STATS=1
